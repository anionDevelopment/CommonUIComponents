[codespell]
# package-lock.json files are auto-generated and contain base64-encoded
# integrity hashes (e.g. "...6gZ+bU+WyI..." or "...DG7RKL/vEw...") which
# codespell misinterprets as typos. These files should not be spell-checked.
# Generated artifacts, build output, dependencies and caches are excluded as
# they are not hand-written source.
skip = ./.git,package-lock.json,*/Other/Artifacts,*/Other/Resources/Artifacts,Other/Resources/Artifacts,Other/Logs,*/Other/Logs,*/node_modules,*/.angular,*/coverage,*.min.js,*.min.css,*.map,*.svg,*.woff,*.woff2,*.ttf,*.eot
