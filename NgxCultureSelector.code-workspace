{
  "folders": [
    {
      "path": ".",
      "name": "Entire repository"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug current file",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "settings": {
    "terminal.integrated.cwd": "${workspaceFolder}",
    "window.title": "${dirty} ${rootName}",
    "files.exclude": {
      ".coverage": true,
      "TestResults": true,
      ".vs": true
    },
    "spellright.language": [
      "en"
    ],
    "spellright.documentTypes": [
      "markdown",
      "plaintext"
    ]
  }
}
