{
  "name": "@aniondev/ngx-darkmode-toggle-button",
  "version": "2.0.1",
  "description": "An angular-component which lets the user choose between the color-schemes system, light and dark.",
  "scripts": {
    "build": "npm run build-QualityCheck",
    "build-Development": "ng build ngx-darkmode-toggle-button --configuration Development",
    "build-Productive": "ng build ngx-darkmode-toggle-button --configuration Productive",
    "build-QualityCheck": "ng build ngx-darkmode-toggle-button --configuration QualityCheck",
    "lint": "ng lint",
    "start": "ng serve demo --configuration Development --host 0.0.0.0 --live-reload=false --disable-host-check",
    "test": "npm run test-QualityCheck",
    "test-Development": "ng test ngx-darkmode-toggle-button --configuration Development --browsers ChromeHeadless --watch false",
    "test-Productive": "ng test ngx-darkmode-toggle-button --configuration Productive --browsers ChromeHeadless --watch false",
    "test-QualityCheck": "ng test ngx-darkmode-toggle-button --configuration QualityCheck --browsers ChromeHeadless --watch false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anionDev/NgxDarkmodeToggleButton.git"
  },
  "homepage": "https://github.com/anionDev/NgxDarkmodeToggleButton#readme",
  "bugs": {
    "url": "https://github.com/anionDev/NgxDarkmodeToggleButton/issues"
  },
  "keywords": [
    "angular",
    "material",
    "dark",
    "darkmode",
    "theme",
    "color-scheme",
    "design",
    "ui"
  ],
  "author": "Marius Göcke <marius.goecke@gmail.com>",
  "license": "ISC",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {},
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.33",
    "@angular/animations": "20.3.27",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.33",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/compiler-cli": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "5.1.7",
    "angular-eslint": "19.2.0",
    "eslint": "9.21.0",
    "jasmine-core": "5.6.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-packagr": "20.3.2",
    "rxjs": "7.8.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.15.0",
    "zone.js": "0.15.0"
  }
}
