{
  "name": "@aniondev/ngx-culture-selector",
  "version": "0.1.1",
  "description": "An angular-component which lets the user choose a culture from a configurable list of cultures.",
  "scripts": {
    "build": "npm run build-QualityCheck",
    "build-Development": "ng build ngx-culture-selector --configuration Development",
    "build-Productive": "ng build ngx-culture-selector --configuration Productive",
    "build-QualityCheck": "ng build ngx-culture-selector --configuration QualityCheck",
    "lint": "ng lint",
    "start": "ng serve demo --configuration Development --host 0.0.0.0 --live-reload=false --disable-host-check",
    "test": "npm run test-QualityCheck",
    "test-Development": "ng test ngx-culture-selector --configuration Development --browsers ChromeHeadless --watch false",
    "test-Productive": "ng test ngx-culture-selector --configuration Productive --browsers ChromeHeadless --watch false",
    "test-QualityCheck": "ng test ngx-culture-selector --configuration QualityCheck --browsers ChromeHeadless --watch false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anionDev/NgxCultureSelector.git"
  },
  "homepage": "https://github.com/anionDev/NgxCultureSelector#readme",
  "bugs": {
    "url": "https://github.com/anionDev/NgxCultureSelector/issues"
  },
  "keywords": [
    "angular",
    "material",
    "culture",
    "locale",
    "i18n",
    "internationalization",
    "language",
    "select",
    "ui"
  ],
  "author": "Marius G\u00f6cke <marius.goecke@mailbox.org>",
  "license": "ISC",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.3",
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/cli": "22.1.3",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/compiler-cli": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "5.1.7",
    "angular-eslint": "19.2.0",
    "eslint": "9.21.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.6.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-packagr": "22.1.1",
    "rxjs": "7.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.15.0",
    "zone.js": "0.15.0"
  }
}